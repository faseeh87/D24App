# ---- core ----
NODE_ENV=production
PORT=3000
# long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# staff panel PIN (6+ characters)
ADMIN_PIN=
DB_PATH=data/d24.db
# Turso (required on Vercel; leave empty to use the local SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Cron authorisation
CRON_SECRET=
# testing only: show OTP on screen when no SMS provider is set
OTP_ON_SCREEN=false

# ---- SMS: console | msg91 | twilio ----
SMS_PROVIDER=console
# also text customers their service reminders & booking confirmations
SMS_REMINDERS=false
# MSG91 (India, DLT-approved templates required)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# flow template with a single variable named "message"
MSG91_REMINDER_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- studio & business rules ----
STUDIO_GSTIN=
GST_RATE=18
BOOKING_SLOTS=09:30,11:30,14:00,16:00
SLOT_CAPACITY=2
# remind this many days before a service is due
REMINDER_DAYS=14
# a service overdue by more than this marks the warranty "at risk"
WARRANTY_GRACE_DAYS=30
